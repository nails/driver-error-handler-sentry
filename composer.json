{
    "name": "nails/driver-error-handler-sentry",
    "keywords":
    [
        "Nails",
        "Shed Collective",
        "CodeIgniter",
        "ErrorHandler",
        "Driver",
        "Sentry"
    ],
    "homepage": "http://nailsapp.co.uk/driver/error-handler/sentry",
    "description": "This driver provides support for sentry.io error handling in Nails",
    "license": "MIT",
    "authors":
    [
        {
            "name": "Pablo de la Pena",
            "email": "p@nailsapp.co.uk",
            "homepage": "http://nailsapp.co.uk",
            "role": "Developer"
        }
    ],
    "support":
    {
        "email": "hello@nailsapp.co.uk"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "autoload":
    {
        "psr-4":
        {
            "Nails\\Common\\ErrorHandler\\": "src/"
        }
    },
    "require":
    {
        "php": ">=8.3"
    },
    "require-dev":
    {
        "phpunit/phpunit": "^12.0",
        "phpstan/phpstan": "^2.0"
    },
    "scripts":
    {
        "test": "./vendor/bin/phpunit",
        "analyse": "./vendor/bin/phpstan analyse -c .phpstan/config.neon"
    },
    "extra":
    {
        "nails":
        {
            "name": "Default",
            "type": "driver",
            "forModule": "nails/common",
            "subType": "ErrorHandler",
            "data":
            {
                "namespace": "Nails\\Common\\ErrorHandler\\",
                "class": "Sentry"
            }
        }
    }
}